# --- release signature verification ------------------------------------------
# ambercli_verify_ref REF
# Verify that git REF (a tag like vX.Y.Z, or any commit-ish: HEAD, FETCH_HEAD,
# origin/main, ...) carries a GOOD GPG signature from the PINNED key. Imports the
# in-repo public key into an EPHEMERAL keyring and confirms its primary
# fingerprint == AMBERCLI_SIGNING_FPR (never trusts the bundled key blindly), then
# requires `git verify-{tag,commit} --raw` to emit a VALIDSIG naming that
# fingerprint -- exit code alone is NOT trusted (a good sig from an unknown key
# must not pass). Returns 0 on success; ambercli_die on failure. Bypassed LOUDLY by
# --no-verify / $AMBERCLI_NO_VERIFY=1.
ambercli_verify_ref() {
    local ref="$1"

    if [ "${AMBERCLI_NO_VERIFY:-0}" = 1 ]; then
        printf '%sWARNING: signature verification BYPASSED (--no-verify) -- running UNVERIFIED code.%s\n' \
            "${AMBERCLI_DIM}" "${AMBERCLI_RESET}" >&2
        return 0
    fi

    ambercli_need gpg
    ambercli_need git

    if [ "$AMBERCLI_SIGNING_FPR" = "REPLACE_WITH_FULL_40_HEX_FINGERPRINT" ]; then
        ambercli_die "signing fingerprint not pinned (AMBERCLI_SIGNING_FPR is still the placeholder). Set it in install + lib, or pass --no-verify to bypass (discouraged)."
    fi

    # Ephemeral keyring; never touch the user's real keyring.
    local gnupg
    gnupg="$(mktemp -d)"
    # shellcheck disable=SC2064  # expand $gnupg now so the RETURN trap cleans the right dir.
    trap "rm -rf '$gnupg'" RETURN
    chmod 700 "$gnupg"

    # Import the embedded public key (_ambercli_signing_key, defined below).
    _ambercli_signing_key | GNUPGHOME="$gnupg" gpg --batch --quiet --import 2>/dev/null \
        || ambercli_die "failed to import the embedded signing key"

    # Confirm the imported key's primary fingerprint matches the pin.
    local imported
    imported="$(GNUPGHOME="$gnupg" gpg --batch --with-colons --fingerprint 2>/dev/null \
        | awk -F: '$1=="fpr"{print $10; exit}')"
    if [ "$imported" != "$AMBERCLI_SIGNING_FPR" ]; then
        ambercli_die "bundled key fingerprint ($imported) does not match pinned AMBERCLI_SIGNING_FPR ($AMBERCLI_SIGNING_FPR) -- refusing."
    fi

    # Verify: tag if REF resolves as one, else commit. Capture --raw status lines.
    local raw kind
    if git -C "$AMBERCLI_SELF_DIR" rev-parse -q --verify "refs/tags/$ref" >/dev/null 2>&1; then
        kind="tag $ref"
        raw="$(GNUPGHOME="$gnupg" git -C "$AMBERCLI_SELF_DIR" verify-tag --raw "$ref" 2>&1 || true)"
    else
        kind="commit $ref"
        raw="$(GNUPGHOME="$gnupg" git -C "$AMBERCLI_SELF_DIR" verify-commit --raw "$ref" 2>&1 || true)"
    fi

    # Require an explicit VALIDSIG naming the pinned fingerprint.
    if printf '%s\n' "$raw" | grep -q "VALIDSIG[^a-zA-Z0-9]*.*${AMBERCLI_SIGNING_FPR}"; then
        return 0
    fi
    ambercli_die "signature verification FAILED for $kind (no VALIDSIG from pinned key $AMBERCLI_SIGNING_FPR). Refusing."
}

# --- update check ------------------------------------------------------------
# Notify-only by default, rate-limited once / 24h. Fully fail-silent; never
# blocks the foreground command and never exits nonzero.
ambercli_check_update() {
    [ "${AMBERCLI_NO_UPDATE_CHECK:-0}" = 1 ] && return 0
    [ -t 1 ] || return 0

    local stamp="$AMBERCLI_CACHE_DIR/last_check" marker="$AMBERCLI_CACHE_DIR/latest"
    mkdir -p "$AMBERCLI_CACHE_DIR" 2>/dev/null || return 0

    # 1) Surface any PENDING result from the previous run.
    if [ -s "$marker" ]; then
        local latest current
        latest="$(head -n1 "$marker" 2>/dev/null)"
        current="$(ambercli_version 2>/dev/null)"
        if [ -n "$latest" ] && [ -n "$current" ] && [ "$latest" != "$current" ]; then
            if [ "${AMBERCLI_AUTO_UPDATE:-0}" = 1 ]; then
                printf '%samber: update available (%s -> %s); will auto-update%s\n' \
                    "$AMBERCLI_DIM" "$current" "$latest" "$AMBERCLI_RESET" >&2
            else
                printf '%samber: update available (%s -> %s); run: amber update%s\n' \
                    "$AMBERCLI_DIM" "$current" "$latest" "$AMBERCLI_RESET" >&2
            fi
        fi
    fi

    # 2) If due (>24h or never), kick a background refresh. touch BEFORE network.
    local due=1
    if [ -f "$stamp" ]; then
        if [ -z "$(find "$stamp" -mmin +1440 2>/dev/null)" ]; then
            due=0
        fi
    fi
    if [ "$due" = 1 ]; then
        touch "$stamp" 2>/dev/null || true
        (
            curl --max-time 2 -s "https://api.github.com/repos/$AMBERCLI_REPO/releases/latest" 2>/dev/null \
                | jq -r '.tag_name // empty' >"$marker" 2>/dev/null
            [ -s "$marker" ] || curl --max-time 2 -s "https://api.github.com/repos/$AMBERCLI_REPO/commits/HEAD" 2>/dev/null \
                | jq -r '.sha[0:12] // empty' >"$marker" 2>/dev/null
        ) >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi
    return 0
}

# --- load user config (secrets / overrides) ----------------------------------
# `if` form (not `&& .`) so a missing env file returns 0 -- a bare `. lib`
